# ---------------------------------------------------------------------------
# DawaQuick — environment configuration
#
# EVERY value here is optional for the prototype. With no .env.local at all the
# app boots on an in-memory mock database seeded with demo data, so you can run
# `npm run dev` immediately.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# MongoDB Atlas connection string. Leave blank/unset to use the in-memory store.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=dawaquick

# --- Session --------------------------------------------------------------
# Used to sign the demo session cookie. Any random string works for the prototype.
SESSION_SECRET=dawaquick-dev-secret-change-me

# --- Third-party placeholders (NOT wired up — prototype simulates these) ---
# Maps / geocoding: the prototype renders a synthetic SVG map instead.
NEXT_PUBLIC_MAPS_API_KEY=REPLACE_WITH_MAPS_API_KEY
NEXT_PUBLIC_MAPS_PROVIDER=mock            # mock | google | mapbox

# SMS / OTP provider (prototype accepts the OTP shown on screen).
SMS_PROVIDER_API_KEY=REPLACE_WITH_SMS_API_KEY
OTP_DEMO_CODE=123456

# Payment gateway (prototype simulates UPI / card / COD).
PAYMENT_GATEWAY_KEY_ID=REPLACE_WITH_PAYMENT_KEY_ID
PAYMENT_GATEWAY_SECRET=REPLACE_WITH_PAYMENT_SECRET

# Voice/telephony for pharmacist -> customer verification calls.
TELEPHONY_API_KEY=REPLACE_WITH_TELEPHONY_API_KEY

# Prescription OCR (prototype uses pre-seeded "extracted" medicine names).
OCR_API_KEY=REPLACE_WITH_OCR_API_KEY

# Object storage for prescription files (prototype stores data URLs in the DB).
BLOB_STORAGE_URL=REPLACE_WITH_BLOB_STORAGE_URL
BLOB_STORAGE_TOKEN=REPLACE_WITH_BLOB_STORAGE_TOKEN

# --- AI providers ---------------------------------------------------------
# Comma-separated pools. The router round-robins and fails over on rate limits,
# first across keys within a provider, then across providers. Leave blank and
# the app behaves exactly as before: the pharmacist types the lines by hand.
#
# Gemini does every job that needs eyes (Groq's text-only tier cannot read an
# image); Groq is the independent second opinion on catalogue matching.
GROQ_API_KEYS=
GEMINI_API_KEYS=
